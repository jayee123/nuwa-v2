# ================================================
# nuwa/v2（公版・NUWA Market）— 環境變數
# ================================================
# 複製成 .env.local 並填入真實值（.env.local 已被 .gitignore 排除）。
#
# ⚠️ 這個檔案會進版控 —— 一律只放佔位符，絕不放真實金鑰。
#
# 本機開發的完整步驟見 docs/LOCAL-SETUP.md。
# ------------------------------------------------
#
# 📌 程式實際會從環境變數讀的，只有下面這些。
#
#    金流（ESAFE_*）、簡訊（SMS_API_KEY）、Email（RESEND_API_KEY）、
#    排程金鑰（CRON_SECRET）【不是環境變數】—— 它們存在資料庫，
#    由後台 /manage 的系統參數頁管理，程式透過 getSecretParam() 讀取。
#    （舊版這份檔案列了它們，照著填只會白忙一場。）


# --- Supabase ---------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>

# 🚨 service_role 會繞過所有 RLS，等同資料庫最高權限。
#    絕不可出現在前端 / log / 截圖 / 版控。外洩必須立刻 reset。
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>


# --- 站台網址 ----------------------------------------------------

# 金流回調與 Email 內的連結會用它組出絕對網址。
# 本機開發設成公版自己的 port。
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# --- 一次性初始化（平常不需要）-------------------------------------
# 只被 /api/setup/superadmin 讀取，用來建立第一個超級管理員。
# 建完就可以拿掉。

# SETUP_SECRET=<random-long-string>
# SUPERADMIN_PHONE=09xxxxxxxx
# SUPERADMIN_PASSWORD=<password>


# --- 本機整合開發（正式站絕不設定）---------------------------------

# SSO 的目標網址平常來自資料庫 apps.app_url（指向正式站的 App）。
# 本機把私版也跑起來時，用這個變數覆寫，就不必去改共用資料庫
#（改了資料庫會讓正式站的 SSO 對所有真實用戶壞掉）。
#
# 變數名規則：DEV_APP_URL_<SLUG 大寫>，見 src/app/api/apps/[slug]/launch/route.ts。
# NODE_ENV=production 時一律忽略，正式站沒有繞過的可能。
# DEV_APP_URL_HAPPY=http://localhost:3001
